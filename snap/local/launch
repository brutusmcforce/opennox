#!/bin/sh
# OpenNox is a 32-bit (i386) program, but the base snap is 64-bit and has no i386 loader or libraries.
# They are bundled in the snap, so run the program with the bundled loader.
# usage: launch <binary> [args...]
set -e
LIB="$SNAP/usr/lib/i386-linux-gnu"
export LIBGL_DRIVERS_PATH="$LIB/dri"
export __EGL_VENDOR_LIBRARY_DIRS="$SNAP/usr/share/glvnd/egl_vendor.d"
export ALSA_CONFIG_PATH="$SNAP/usr/share/alsa/alsa.conf"
bin="$1"
shift
exec "$LIB/ld-linux.so.2" --library-path "$LIB:$LIB/pulseaudio" "$SNAP/bin/$bin" "$@"
