FROM golang:1.25

ARG UID=1000
ARG GID=1000
ARG GIT_SHA=""
ARG GIT_TAG=""

RUN apt-get update && \
    apt-get install -y \
                        gcc \
                        libsdl2-dev libopenal-dev

RUN groupadd --gid $GID runner && \
    useradd --home-dir /home/runner --no-create-home --gid runner --uid $UID --shell /bin/sh runner

WORKDIR /home/runner/opennox

ADD ./go.* ./

RUN go mod download

ADD . .

RUN go run ./internal/noxbuild client && ./opennox -h
